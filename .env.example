POSTGRES_USER=notes
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=notes
DATABASE_URL=postgresql+psycopg://notes:replace-with-a-long-random-password@db:5432/notes
APP_ENV=development
APP_ORIGIN=http://localhost:8080
COOKIE_SECURE=false
SESSION_DAYS=7
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_SECONDS=300
JOB_LEASE_SECONDS=30

# Local development: API and Worker must use the same storage directory.
STORAGE_BACKEND=local
STORAGE_ROOT=.local/files
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PIXELS=40000000
UPLOAD_BATCH_LIMIT=50
STORAGE_QUOTA_BYTES=1073741824
UPLOAD_EXPIRY_SECONDS=600
FILE_TICKET_SECONDS=300
UPLOAD_READ_TIMEOUT_SECONDS=60

# Private OSS: set STORAGE_BACKEND=oss and configure on the server only.
OSS_REGION=cn-hangzhou
OSS_BUCKET=ai-notes-prod-20261014
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=ai-notes/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=

# Shared DeepSeek credential, supplied only to the backend. Never use a VITE_ variable.
DEEPSEEK_API_KEY=

PDF_MAX_BYTES=52428800
PDF_MAX_PAGES=200
PDF_PAGE_TIMEOUT_SECONDS=60

# Account export: uncompressed payload bytes; the browser accepts at most 512 MiB.
EXPORT_MAX_BYTES=536870912
EXPORT_MAX_ROWS=50000
EXPORT_MAX_METADATA_BYTES=33554432
EXPORT_MAX_SECONDS=120
