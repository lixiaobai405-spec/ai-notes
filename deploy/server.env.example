# Development integration only. Generate .env.server with scripts/init_server_env.py.
ACR_REGISTRY=crpi-example.cn-hangzhou.personal.cr.aliyuncs.com
ACR_NAMESPACE=ai-notes
RELEASE_TAG=sha-0000000000000000000000000000000000000000-1-1
POSTGRES_USER=notes
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=notes
DATABASE_URL=postgresql+psycopg://notes:replace-with-a-long-random-password@db:5432/notes
APP_ENV=development
APP_ORIGIN=http://127.0.0.1:8080
COOKIE_SECURE=false
SESSION_DAYS=7
RATE_LIMIT_REQUESTS=10
RATE_LIMIT_SECONDS=300
JOB_LEASE_SECONDS=30
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
STORAGE_BACKEND=oss
STORAGE_ROOT=/var/lib/ai-notes/files
UPLOAD_MAX_BYTES=20971520
UPLOAD_MAX_PIXELS=40000000
UPLOAD_BATCH_LIMIT=50
STORAGE_QUOTA_BYTES=1073741824
UPLOAD_EXPIRY_SECONDS=600
FILE_TICKET_SECONDS=300
UPLOAD_READ_TIMEOUT_SECONDS=60
OSS_REGION=cn-hangzhou
OSS_BUCKET=ai-notes-prod-20261014
OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_PREFIX=ai-notes/
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=

# Configure separately only when authorizing this server to use the shared DeepSeek account.
DEEPSEEK_API_KEY=

PDF_MAX_BYTES=52428800
PDF_MAX_PAGES=200
PDF_PAGE_TIMEOUT_SECONDS=60

EXPORT_MAX_BYTES=536870912
EXPORT_MAX_ROWS=50000
EXPORT_MAX_METADATA_BYTES=33554432
EXPORT_MAX_SECONDS=120
